{
  "version": 2,
  "buildCommand": "python manage.py collectstatic --noinput",
  "builds": [
    {
      "src": "artiste/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/collection/static/(.*)",
      "dest": "/collection/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "artiste/wsgi.py"
    }
  ]
}